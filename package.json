{
  "name": "qarinah",
  "version": "0.1.2",
  "description": "Cross-agent context engine with verified handoffs and 98.71% less estimated repeated context in its published benchmark.",
  "license": "Apache-2.0",
  "author": "Ajnas NB",
  "mcpName": "io.github.AjnasNB/qarinah",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "qarinah": "bin/qarinah.js"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./codex": {
      "types": "./types/codex.d.ts",
      "default": "./src/hooks/codex.js"
    },
    "./claude": {
      "types": "./types/claude.d.ts",
      "default": "./src/hooks/claude.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./src/mcp/server.js"
    },
    "./schemas/event.json": "./schemas/event.schema.json",
    "./schemas/context-pack.json": "./schemas/context-pack.schema.json",
    "./schemas/project-structure.json": "./schemas/project-structure.schema.json",
    "./schemas/okf-export.json": "./schemas/okf-export.schema.json",
    "./schemas/maqam-context-adapter.json": "./schemas/maqam-context-adapter.schema.json",
    "./schemas/cockroach-source-record.json": "./schemas/cockroach-source-record.schema.json",
    "./schemas/cockroach-browser-memory.json": "./schemas/cockroach-browser-memory.schema.json",
    "./schemas/productloop-runtime-event.json": "./schemas/productloop-runtime-event.schema.json",
    "./schemas/team-manifest.json": "./schemas/team-manifest.schema.json",
    "./schemas/causal-receipt.json": "./schemas/causal-receipt.schema.json",
    "./schemas/federated-context.json": "./schemas/federated-context.schema.json",
    "./schemas/memory-attachment.json": "./schemas/memory-attachment.schema.json"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "schemas/",
    "docs/ARCHITECTURE.md",
    "docs/GETTING-STARTED.md",
    "docs/CROSS-AGENT-HANDOFFS.md",
    "docs/architecture.mmd",
    "docs/WHITEPAPER.md",
    "docs/BENCHMARKS.md",
    "docs/SECURITY.md",
    "docs/ROADMAP.md",
    "docs/PRODUCT-STRATEGY.md",
    "docs/INTEROPERABILITY.md",
    "docs/HOST-INTEGRATIONS.md",
    "docs/CLI-REFERENCE.md",
    "docs/API-REFERENCE.md",
    "docs/MCP-GUIDE.md",
    "docs/TOKEN-EFFICIENT-CONTEXT.md",
    "docs/RECIPES.md",
    "docs/TROUBLESHOOTING.md",
    "docs/FAQ.md",
    "docs/GOVERNED-BROWSER.md",
    "docs/LAUNCH.md",
    "docs/launch/",
    "docs/ECOSYSTEM-LAUNCH.md",
    "docs/LICENSE-STRATEGY.md",
    "docs/MIGRATIONS.md",
    "docs/TEAM-MEMORY.md",
    "docs/SQLITE-READ-MODEL.md",
    "docs/TEMPORAL-AUTHORITY.md",
    "bench/fixtures/software-task-scenarios.mjs",
    "bench/results/",
    "scripts/evaluate-software-tasks.mjs",
    "scripts/evaluate-long-document.mjs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "CODE_OF_CONDUCT.md",
    "SUPPORT.md",
    "PRIVACY.md",
    "TRADEMARKS.md",
    "SECURITY.md",
    "assets/brand/qarinah-mark.svg",
    "assets/launch/",
    "assets/architecture/",
    "examples/",
    "integrations/codex/qarinah/",
    "integrations/claude/qarinah/",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:codex-plugin": "npm run build:plugins",
    "check:plugins": "node scripts/build-plugins.mjs --check",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:codex-plugin": "npm run check:plugins",
    "mcp:smoke": "node scripts/mcp-transport-smoke.mjs",
    "prepack": "npm run check:plugins",
    "prepublishOnly": "npm run check",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node scripts/typecheck-consumer.mjs",
    "check": "npm run check:plugins && npm run check:docs && npm run build:site && npm run check:site && npm run mcp:smoke && npm test && npm run typecheck && npm run check:benchmark-evidence && npm run benchmark && npm run evaluate:context && npm run evaluate:software-tasks && npm run evaluate:long-document && npm pack --dry-run --ignore-scripts",
    "check:benchmark-evidence": "node scripts/verify-benchmark-evidence.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate:context": "node scripts/evaluate-context.mjs",
    "evaluate:software-tasks": "node scripts/evaluate-software-tasks.mjs",
    "evaluate:long-document": "node scripts/evaluate-long-document.mjs"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjnasNB/qarinah.git"
  },
  "bugs": {
    "url": "https://github.com/AjnasNB/qarinah/issues"
  },
  "homepage": "https://qarinah.io",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "latest"
  },
  "keywords": [
    "agent-context",
    "agent-memory",
    "ai-agent-memory",
    "coding-agent-memory",
    "cross-agent-context",
    "universal-context-engine",
    "agent-handoff",
    "project-memory",
    "context-graph",
    "context-management",
    "context-retrieval",
    "context-compression",
    "context-window",
    "llm-context",
    "token-optimization",
    "token-efficiency",
    "token-reduction",
    "provenance",
    "governance",
    "local-first",
    "developer-tools",
    "mcp-server",
    "codex",
    "claude-code",
    "codex-plugin",
    "claude-code-plugin",
    "audit-log",
    "knowledge-graph",
    "context-engineering",
    "open-knowledge-format"
  ],
  "devDependencies": {
    "@primer/css": "^22.3.0",
    "cockroach-browser": "0.1.0",
    "esbuild": "0.28.1",
    "marked": "^18.0.7",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ignore": "7.0.6"
  }
}
