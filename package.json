{
  "name": "qarinah",
  "version": "0.1.0-alpha.2",
  "description": "Qarinah: evidence-linked, local-first context compilation for software agents.",
  "license": "Apache-2.0",
  "author": "Ajnas NB",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "qarinah": "bin/qarinah.js"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./codex": {
      "types": "./types/codex.d.ts",
      "default": "./src/hooks/codex.js"
    },
    "./claude": {
      "types": "./types/claude.d.ts",
      "default": "./src/hooks/claude.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./src/mcp/server.js"
    },
    "./schemas/event.json": "./schemas/event.schema.json",
    "./schemas/context-pack.json": "./schemas/context-pack.schema.json",
    "./schemas/project-structure.json": "./schemas/project-structure.schema.json",
    "./schemas/okf-export.json": "./schemas/okf-export.schema.json",
    "./schemas/maqam-context-adapter.json": "./schemas/maqam-context-adapter.schema.json",
    "./schemas/cockroach-source-record.json": "./schemas/cockroach-source-record.schema.json",
    "./schemas/productloop-runtime-event.json": "./schemas/productloop-runtime-event.schema.json"
  },
  "files": [
    "bin/",
    "src/",
    "types/",
    "schemas/",
    "docs/ARCHITECTURE.md",
    "docs/BENCHMARKS.md",
    "docs/SECURITY.md",
    "docs/ROADMAP.md",
    "docs/PRODUCT-STRATEGY.md",
    "docs/INTEROPERABILITY.md",
    "docs/HOST-INTEGRATIONS.md",
    "docs/GOVERNED-BROWSER.md",
    "docs/LAUNCH.md",
    "docs/LICENSE-STRATEGY.md",
    "docs/MIGRATIONS.md",
    "bench/results/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SUPPORT.md",
    "PRIVACY.md",
    "TRADEMARKS.md",
    "SECURITY.md",
    "assets/brand/qarinah-mark.svg",
    "examples/",
    "integrations/codex/qarinah/",
    "integrations/claude/qarinah/",
    "README.md"
  ],
  "scripts": {
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:codex-plugin": "npm run build:plugins",
    "check:plugins": "node scripts/build-plugins.mjs --check",
    "check:codex-plugin": "npm run check:plugins",
    "prepack": "npm run check:plugins",
    "prepublishOnly": "npm run check",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node scripts/typecheck-consumer.mjs",
    "check": "npm run check:plugins && npm test && npm run typecheck && npm run check:benchmark-evidence && npm run benchmark && npm run evaluate:context && npm pack --dry-run --ignore-scripts",
    "check:benchmark-evidence": "node scripts/verify-benchmark-evidence.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate:context": "node scripts/evaluate-context.mjs"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjnasNB/qarinah.git"
  },
  "bugs": {
    "url": "https://github.com/AjnasNB/qarinah/issues"
  },
  "homepage": "https://github.com/AjnasNB/qarinah#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "keywords": [
    "agent-context",
    "context-graph",
    "provenance",
    "governance",
    "codex",
    "claude-code",
    "audit-log",
    "knowledge-graph",
    "context-engineering"
  ],
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ignore": "7.0.6"
  }
}
