{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AjnasNB/qarinah/schemas/encrypted-knowledge.schema.json",
  "title": "Qarinah hosted encrypted knowledge envelope",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "workspaceId", "teamManifestHash", "nonce", "ciphertext", "authenticationTag"],
  "properties": {
    "schemaVersion": { "const": "qarinah.encrypted-sync-bundle.v1" },
    "algorithm": { "const": "AES-256-GCM" },
    "workspaceId": { "type": "string", "pattern": "^ws_[0-9a-f]{32}$" },
    "teamManifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[A-Za-z0-9+/]{16}$" },
    "ciphertext": { "type": "string", "maxLength": 8000000, "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
    "authenticationTag": { "type": "string", "minLength": 24, "maxLength": 24, "pattern": "^[A-Za-z0-9+/]{22}==$" }
  },
  "description": "Runtime also enforces canonical base64, exact decoded nonce/tag lengths, a six-million-byte ciphertext ceiling, and an eight-million-byte complete envelope ceiling. The service cannot decrypt this envelope."
}
