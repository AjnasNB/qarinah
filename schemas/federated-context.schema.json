{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qarinah.io/schemas/federated-context.schema.json",
  "title": "Qarinah federated context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "query", "authorityBoundary", "workspaces", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": "qarinah.federated-context.v1" },
    "query": { "type": "string", "maxLength": 4096 },
    "authorityBoundary": { "const": "separate-packs" },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "workspaceId", "pack"],
        "properties": {
          "authority": { "type": "string", "minLength": 1, "maxLength": 256 },
          "workspaceId": { "type": "string" },
          "pack": { "type": "object" }
        }
      }
    },
    "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
