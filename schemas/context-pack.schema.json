{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AjnasNB/qarinah/schemas/context-pack.schema.json",
  "title": "Qarinah context pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceId",
    "query",
    "contentRole",
    "budget",
    "retrieval",
    "items",
    "truncated",
    "manifestHash"
  ],
  "properties": {
    "schemaVersion": { "const": "qarinah.context-pack.v1" },
    "workspaceId": { "type": "string", "pattern": "^ws_[0-9a-f]{32}$" },
    "query": { "type": "string", "maxLength": 4096 },
    "contentRole": { "const": "untrusted-data" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChars", "usedChars", "estimatedTokens"],
      "properties": {
        "maxChars": { "type": "integer", "minimum": 512, "maximum": 1000000 },
        "usedChars": { "type": "integer", "minimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 },
        "maxTokens": { "type": "integer", "minimum": 128, "maximum": 1000000 },
        "usedTokens": { "type": "integer", "minimum": 0 },
        "reservedTokens": { "type": "integer", "minimum": 0 },
        "availableTokens": { "type": "integer", "minimum": 64 },
        "estimator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "exact"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "exact": { "type": "boolean" }
          }
        },
        "allocations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framing", "citations", "content"],
          "properties": {
            "framing": { "type": "integer", "minimum": 0 },
            "citations": { "type": "integer", "minimum": 0 },
            "content": { "type": "integer", "minimum": 0 }
          }
        },
        "reservationPolicyHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "dependentRequired": {
        "maxTokens": ["usedTokens", "reservedTokens", "availableTokens", "estimator", "allocations", "reservationPolicyHash"]
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "supersessionPolicy", "asOf"],
      "properties": {
        "strategy": { "const": "hybrid-local-v1" },
        "supersessionPolicy": { "enum": ["prefer-current", "include-history"] },
        "asOf": { "type": "string", "format": "date-time", "maxLength": 24 },
        "authorityScope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expired", "future"],
          "properties": {
            "expired": { "type": "integer", "minimum": 0 },
            "future": { "type": "integer", "minimum": 0 }
          },
          "anyOf": [
            { "properties": { "expired": { "minimum": 1 } } },
            { "properties": { "future": { "minimum": 1 } } }
          ]
        },
        "conflicts": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventIds"],
            "properties": {
              "eventIds": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^evt_[0-9a-f-]{36}$", "maxLength": 64 }
              }
            }
          }
        },
        "exclusions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["eventId", "reason", "by"],
            "properties": {
              "eventId": { "type": "string", "pattern": "^evt_[0-9a-f-]{36}$", "maxLength": 64 },
              "reason": { "const": "superseded" },
              "by": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^evt_[0-9a-f-]{36}$", "maxLength": 64 }
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "kind", "timestamp", "title", "excerpt", "confidence", "reason", "hash"],
        "properties": {
          "eventId": { "type": "string", "maxLength": 64 },
          "kind": { "type": "string", "maxLength": 64 },
          "timestamp": { "type": "string", "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$", "maxLength": 24 },
          "title": { "type": "string", "maxLength": 512 },
          "excerpt": { "type": "string", "maxLength": 65536 },
          "confidence": { "enum": ["extracted", "inferred", "claimed", "verified"] },
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "rank", "assignedBy", "assignedAt", "expiresAt", "revokedAt", "basis"],
            "properties": {
              "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
              "rank": { "type": "integer", "minimum": 0, "maximum": 100 },
              "assignedBy": { "type": "string", "minLength": 1, "maxLength": 256 },
              "assignedAt": { "type": "string", "maxLength": 24 },
              "expiresAt": { "type": ["string", "null"], "maxLength": 24 },
              "revokedAt": { "type": ["string", "null"], "maxLength": 24 },
              "basis": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          },
          "reason": { "type": "string", "maxLength": 512 },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "truncated": { "type": "boolean" },
    "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
