{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qarinah.io/schemas/host-install-manifest.schema.json",
  "title": "Qarinah host installation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "installedAt", "workspaceId", "root", "host", "scope", "interpreter", "binary", "options", "files"],
  "properties": {
    "schemaVersion": { "const": "qarinah.host-install-manifest.v1" },
    "packageVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "installedAt": { "type": "string", "format": "date-time" },
    "workspaceId": { "type": "string", "pattern": "^ws_[a-f0-9]{32}$" },
    "root": { "type": "string", "minLength": 1 },
    "host": { "enum": ["codex", "claude", "cursor", "kimi", "antigravity", "freebuff"] },
    "scope": { "const": "project" },
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowQuery", "autoCompact"],
      "properties": {
        "allowQuery": { "type": "boolean" },
        "autoCompact": { "type": "boolean" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ownership", "installed"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 256 },
          "ownership": { "enum": ["exact", "managed-toml", "managed-mcp", "managed-hooks"] },
          "installed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exists", "digest", "bytes"],
            "properties": {
              "exists": { "const": true },
              "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 524288 }
            }
          }
        }
      }
    }
  }
}
