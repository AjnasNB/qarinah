{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AjnasNB/qarinah/schemas/cockroach-source-record.schema.json",
  "title": "Qarinah structural boundary for Cockroach Crawler SourceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source", "id", "type", "title", "url", "text", "author", "publishedAt",
    "contentHash", "adapterVersion", "warnings", "metadata", "provenance"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1, "maxLength": 128 },
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "maxLength": 65536 },
    "url": { "type": "string", "maxLength": 8192 },
    "text": { "type": "string", "maxLength": 1000000 },
    "author": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
    "publishedAt": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "maxLength": 24 },
        { "type": "null" }
      ]
    },
    "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 512 }
    },
    "metadata": { "type": "object", "additionalProperties": true },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrievedAt", "method", "authenticated", "credentialed"],
      "properties": {
        "retrievedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$", "maxLength": 24 },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "authenticated": { "type": "boolean" },
        "credentialed": { "type": "boolean" }
      }
    }
  }
}
