{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AjnasNB/qarinah/schemas/event.schema.json",
  "title": "Qarinah event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "timestamp",
    "workspaceId",
    "sessionId",
    "turnId",
    "kind",
    "actor",
    "title",
    "body",
    "data",
    "confidence",
    "relations",
    "provenance",
    "retention",
    "previousHash",
    "hash"
  ],
  "properties": {
    "schemaVersion": { "const": "qarinah.event.v1" },
    "eventId": { "type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "maxLength": 64 },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$", "maxLength": 24 },
    "workspaceId": { "type": "string", "pattern": "^ws_[0-9a-f]{32}$" },
    "sessionId": { "type": ["string", "null"], "maxLength": 256 },
    "turnId": { "type": ["string", "null"], "maxLength": 256 },
    "kind": {
      "enum": [
        "session.started",
        "prompt.submitted",
        "tool.requested",
        "tool.completed",
        "turn.completed",
        "compaction.started",
        "compaction.completed",
        "artifact",
        "source",
        "claim",
        "decision",
        "approval",
        "summary",
        "memory.scope.attached",
        "memory.scope.revoked",
        "context.pack.compiled"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["human", "agent", "tool", "system", "source"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "body": { "type": "string", "maxLength": 65536 },
    "data": { "type": "object", "maxProperties": 128 },
    "confidence": { "enum": ["extracted", "inferred", "claimed", "verified"] },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validFrom": { "type": "string", "format": "date-time", "maxLength": 24 },
        "validUntil": { "type": ["string", "null"], "format": "date-time", "maxLength": 24 }
      },
      "minProperties": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 256 },
        "commit": { "type": "string", "minLength": 7, "maxLength": 128 }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "hash"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "dependencies": {
          "type": "array", "maxItems": 256,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "hash"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "version": { "type": "string", "minLength": 1, "maxLength": 128 },
              "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      },
      "minProperties": 1
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopes", "classification"],
      "properties": {
        "scopes": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "classification": { "enum": ["public", "workspace", "restricted"] }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "rank", "assignedBy", "assignedAt", "expiresAt", "revokedAt", "basis"],
      "properties": {
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "rank": { "type": "integer", "minimum": 0, "maximum": 100 },
        "assignedBy": { "type": "string", "minLength": 1, "maxLength": 256 },
        "assignedAt": { "type": "string", "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$", "maxLength": 24 },
        "expiresAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$", "maxLength": 24 },
        "revokedAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$", "maxLength": 24 },
        "basis": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": [
              "derived_from",
              "produced",
              "changed",
              "supports",
              "contradicts",
              "supersedes",
              "authorized_by",
              "governed_by",
              "affects",
              "references"
            ]
          },
          "target": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "sourceId", "contentHash"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceId": { "type": ["string", "null"], "maxLength": 512 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "expiresAt"],
      "properties": {
        "class": { "enum": ["session", "project", "durable"] },
        "expiresAt": { "type": ["string", "null"], "format": "date-time", "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$", "maxLength": 24 }
      }
    },
    "previousHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
